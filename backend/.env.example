# Database Configuration (for production use DATABASE_URL instead)
DISABLE_DB=false
DATABASE_URL=postgres://username:password@your-database-host:5432/your-database-name
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=velog

# Application Configuration
PORT=8000
NODE_ENV=production

# Frontend URL for CORS
FRONTEND_URL=https://your-frontend-domain.vercel.app

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-please-change-in-production
JWT_EXPIRES_IN=12h

# JWT Refresh Token Configuration
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-here-please-change-in-production


