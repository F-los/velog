# ============================================
# Database Configuration
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=velog

# For production, you can use DATABASE_URL instead
# DATABASE_URL=postgres://username:password@your-database-host:5432/your-database-name

# Optional: Disable database for testing
# DISABLE_DB=false

# ============================================
# JWT Configuration (REQUIRED - No Defaults!)
# ============================================
# ⚠️ CRITICAL: These secrets MUST be set in production
# Generate strong secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Access Token Secret (minimum 32 characters)
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MINIMUM_32_CHARS

# Refresh Token Secret (minimum 32 characters, must be different from JWT_SECRET)
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET_MINIMUM_32_CHARS

# Token Expiration Times
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS Configuration
# ============================================
# Frontend URL for CORS (comma-separated for multiple domains)
FRONTEND_URL=http://localhost:3000

# For production:
# FRONTEND_URL=https://your-frontend-domain.vercel.app,https://www.your-domain.com

# ============================================
# Application Configuration
# ============================================
PORT=8000
NODE_ENV=development

# For production:
# NODE_ENV=production


